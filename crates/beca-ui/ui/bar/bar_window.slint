import { Theme } from "../theme.slint";
import { ClockWidget } from "./clock_widget.slint";
import { LauncherWidget } from "./launcher_widget.slint";
import { VolumeWidget } from "./volume_widget.slint";
import { ConversationWidget } from "./conversation_widget.slint";

export component BarWindow inherits Window {
    in-out property <string> position: "top";
    in-out property <string> clock-text: "--:--";
    in-out property <bool> show-launcher: true;
    in-out property <bool> show-clock: true;
    in-out property <string> launcher-label: "Apps";
    in-out property <bool> show-volume-out: true;
    in-out property <bool> show-volume-in: true;
    in-out property <string> volume-out-text: "--%";
    in-out property <string> volume-in-text: "--%";
    in-out property <bool> volume-out-muted: false;
    in-out property <bool> volume-in-muted: false;
    in-out property <bool> show-conversation: true;
    in-out property <bool> conversation-active: false;

    in-out property <string> clock-section: "center";
    in-out property <string> launcher-section: "left";
    in-out property <string> volume-out-section: "right";
    in-out property <string> volume-in-section: "right";
    in-out property <string> conversation-section: "center";

    in-out property <string> left-align: "start";
    in-out property <string> center-align: "center";
    in-out property <string> right-align: "end";
    in-out property <float> background-opacity: 1.0;
    in-out property <bool> show-border: false;
    callback launcher-clicked();
    callback conversation-clicked();

    property <[string]> section-names: ["left", "center", "right"];
    property <LayoutAlignment> left-align-value:
        root.left-align == "start" ? start : (root.left-align == "end" ? end : center);
    property <LayoutAlignment> center-align-value:
        root.center-align == "start" ? start : (root.center-align == "end" ? end : center);
    property <LayoutAlignment> right-align-value:
        root.right-align == "start" ? start : (root.right-align == "end" ? end : center);

    title: "beca-bar";
    no-frame: true;
    background: transparent;

    preferred-width: 800px;
    min-width: 320px;
    height: 34px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.card-bg.with-alpha(root.background-opacity);
        border-radius: 0px;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: stretch;

            for section[i] in root.section-names : Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 4px;
                    alignment: i == 0 ? root.left-align-value
                        : (i == 1 ? root.center-align-value : root.right-align-value);

                    if root.show-launcher && root.launcher-section == section : LauncherWidget {
                        label: root.launcher-label;
                        clicked => { root.launcher-clicked(); }
                    }
                    if root.show-clock && root.clock-section == section : ClockWidget {
                        time-text: root.clock-text;
                    }
                    if root.show-conversation && root.conversation-section == section : ConversationWidget {
                        icon-color: root.conversation-active ? #f7768e : Theme.accent;
                        active: root.conversation-active;
                        clicked => { root.conversation-clicked(); }
                    }
                    if root.show-volume-out && root.volume-out-section == section : VolumeWidget {
                        label: "󰕾";
                        value-text: root.volume-out-text;
                        muted: root.volume-out-muted;
                    }
                    if root.show-volume-in && root.volume-in-section == section : VolumeWidget {
                        label: "󰍬";
                        value-text: root.volume-in-text;
                        muted: root.volume-in-muted;
                    }
                }
            }
        }
    }
}
