import { Theme } from "../theme.slint";
import { ClockWidget } from "./clock_widget.slint";
import { LauncherWidget } from "./launcher_widget.slint";
import { VolumeWidget } from "./volume_widget.slint";
import { ConversationWidget } from "./conversation_widget.slint";
import { InfoWidget } from "./info_widget.slint";

export component BarWindow inherits Window {
    in-out property <string> position: "top";
    in-out property <string> clock-text: "--:--";
    in-out property <bool> show-launcher: true;
    in-out property <bool> show-clock: true;
    in-out property <string> launcher-label: "Apps";
    in-out property <bool> show-volume-out: true;
    in-out property <bool> show-volume-in: true;
    in-out property <string> volume-out-text: "--%";
    in-out property <string> volume-in-text: "--%";
    in-out property <bool> volume-out-muted: false;
    in-out property <bool> volume-in-muted: false;
    in-out property <bool> show-conversation: true;
    in-out property <bool> conversation-active: false;
    in-out property <bool> show-network: false;
    in-out property <string> network-text: "--";
    in-out property <bool> show-alerts: false;
    in-out property <string> alerts-text: "0";
    in-out property <bool> show-bluetooth: false;
    in-out property <string> bluetooth-text: "--";
    in-out property <bool> show-cpu: false;
    in-out property <string> cpu-text: "--%";
    in-out property <bool> show-memory: false;
    in-out property <string> memory-text: "--%";
    in-out property <bool> show-disk: false;
    in-out property <string> disk-text: "--%";

    in-out property <string> clock-section: "center";
    in-out property <string> launcher-section: "begin";
    in-out property <string> volume-out-section: "end";
    in-out property <string> volume-in-section: "end";
    in-out property <string> conversation-section: "center";
    in-out property <string> network-section: "end";
    in-out property <string> alerts-section: "center";
    in-out property <string> bluetooth-section: "end";
    in-out property <string> cpu-section: "begin";
    in-out property <string> memory-section: "begin";
    in-out property <string> disk-section: "begin";

    in-out property <string> begin-align: "start";
    in-out property <string> center-align: "center";
    in-out property <string> end-align: "end";
    in-out property <float> background-opacity: 1.0;
    in-out property <bool> show-border: false;
    in-out property <brush> bar-background: Theme.card-bg;
    callback launcher-clicked();
    callback conversation-clicked();
    callback volume-out-scrolled(float);
    callback volume-in-scrolled(float);
    callback alerts-clicked();
    callback volume-out-clicked();
    callback volume-in-clicked();
    callback network-clicked();
    callback bluetooth-clicked();

    property <[string]> section-names: ["begin", "center", "end"];
    property <LayoutAlignment> begin-align-value:
        root.begin-align == "start" ? start : (root.begin-align == "end" ? end : center);
    property <LayoutAlignment> center-align-value:
        root.center-align == "start" ? start : (root.center-align == "end" ? end : center);
    property <LayoutAlignment> end-align-value:
        root.end-align == "start" ? start : (root.end-align == "end" ? end : center);

    title: "beca-bar";
    no-frame: true;
    background: transparent;

    preferred-width: 800px;
    min-width: 320px;
    height: 34px;

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bar-background.with-alpha(root.background-opacity);
        border-radius: 0px;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            spacing: 4px;
            alignment: stretch;

            for section[i] in root.section-names : Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                HorizontalLayout {
                    width: 100%;
                    height: 100%;
                    spacing: 4px;
                    alignment: i == 0 ? root.begin-align-value
                        : (i == 1 ? root.center-align-value : root.end-align-value);

                    if root.show-launcher && root.launcher-section == section : LauncherWidget {
                        label: root.launcher-label;
                        clicked => { root.launcher-clicked(); }
                    }
                    if root.show-clock && root.clock-section == section : ClockWidget {
                        time-text: root.clock-text;
                    }
                    if root.show-conversation && root.conversation-section == section : ConversationWidget {
                        icon-color: root.conversation-active ? Theme.m3-error : Theme.m3-primary;
                        active: root.conversation-active;
                        clicked => { root.conversation-clicked(); }
                    }
                    if root.show-volume-out && root.volume-out-section == section : VolumeWidget {
                        label: "󰕾";
                        value-text: root.volume-out-text;
                        muted: root.volume-out-muted;
                        scrolled(delta) => { root.volume-out-scrolled(delta); }
                        clicked => { root.volume-out-clicked(); }
                    }
                    if root.show-volume-in && root.volume-in-section == section : VolumeWidget {
                        label: "󰍬";
                        value-text: root.volume-in-text;
                        muted: root.volume-in-muted;
                        scrolled(delta) => { root.volume-in-scrolled(delta); }
                        clicked => { root.volume-in-clicked(); }
                    }
                    if root.show-network && root.network-section == section : InfoWidget {
                        icon: "󰖩";
                        text: root.network-text;
                        clickable: true;
                        clicked => { root.network-clicked(); }
                    }
                    if root.show-alerts && root.alerts-section == section : InfoWidget {
                        icon: "󰂚";
                        text: root.alerts-text;
                        clickable: true;
                        clicked => { root.alerts-clicked(); }
                    }
                    if root.show-bluetooth && root.bluetooth-section == section : InfoWidget {
                        icon: "󰂯";
                        text: root.bluetooth-text;
                        clickable: true;
                        clicked => { root.bluetooth-clicked(); }
                    }
                    if root.show-cpu && root.cpu-section == section : InfoWidget {
                        icon: "󰍛";
                        text: root.cpu-text;
                    }
                    if root.show-memory && root.memory-section == section : InfoWidget {
                        icon: "󰘚";
                        text: root.memory-text;
                    }
                    if root.show-disk && root.disk-section == section : InfoWidget {
                        icon: "󰋊";
                        text: root.disk-text;
                    }
                }
            }
        }
    }
}
