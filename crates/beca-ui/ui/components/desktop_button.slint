import { Theme } from "../theme.slint";

export component DesktopButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked;

    height: 40px;
    min-width: 96px;
    border-radius: Theme.m3-shape-full;
    background: !root.enabled ? Theme.m3-primary.with-alpha(0.12)
        : touch-area.pressed ? Theme.m3-primary.darker(15%)
        : touch-area.has-hover ? Theme.m3-primary.brighter(8%)
        : Theme.m3-primary;

    animate background { duration: 120ms; }

    touch-area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        alignment: center;
        padding-left: 24px;
        padding-right: 24px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.m3-on-surface.with-alpha(0.38) : Theme.m3-on-primary;
            font-size: 14px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}
