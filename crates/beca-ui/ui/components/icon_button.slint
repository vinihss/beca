import { Theme } from "../theme.slint";

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 40px;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    opacity: root.enabled ? 1.0 : 0.38;
    background: root.active ? Theme.m3-secondary-container : transparent;

    state-layer := Rectangle {
        border-radius: parent.border-radius;
        background: touch.pressed ? Theme.m3-on-surface
            : touch.has-hover ? Theme.m3-on-surface : transparent;
        opacity: (touch.has-hover && root.enabled) ? (touch.pressed ? Theme.m3-state-pressed : Theme.m3-state-hover) : 0;
    }

    Text {
        width: 100%;
        height: 100%;
        text: root.icon;
        font-family: Theme.icon-font-family;
        font-size: root.size * 0.5;
        color: root.active ? Theme.m3-on-secondary-container : Theme.m3-on-surface-variant;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: root.enabled ? pointer : default;
    }
}
