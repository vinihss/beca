import { Theme } from "../theme.slint";
import { M3LinearProgress, M3CircularProgress } from "progress.slint";

// Skeleton placeholder block
export component M3Skeleton inherits Rectangle {
    in property <length> skeleton-width: 120px;
    in property <length> skeleton-height: 12px;
    width: root.skeleton-width;
    height: root.skeleton-height;
    border-radius: root.skeleton-height / 2;
    background: Theme.m3-surface-container-highest;
    opacity: 0.7 + 0.3 * mod(animation-tick() / 1.2s, 1);
}

// Loading container with message and indicator
export component M3LoadingState inherits Rectangle {
    in property <string> label: "Loading…";
    in property <bool> show-progress: true;
    in property <bool> indeterminate: true;
    in property <float> progress: 0.0;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;
        padding: 16px;

        if root.show-progress : M3CircularProgress {
            indeterminate: root.indeterminate;
            progress: root.progress;
            size: 40px;
        }

        if root.label != "" : Text {
            text: root.label;
            color: Theme.m3-on-surface-variant;
            font-size: 14px;
            horizontal-alignment: center;
        }
    }
}

// Button/content loading overlay pattern
export component M3LoadingOverlay inherits Rectangle {
    in property <bool> loading: false;
    in property <string> label: "Loading…";

    if root.loading : Rectangle {
        width: 100%; height: 100%;
        background: Theme.m3-surface;
        opacity: 0.7;
    }
    if root.loading : M3LoadingState {
        label: root.label;
    }
    @children
}
