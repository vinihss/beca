import { Theme } from "../theme.slint";

// Material 3 Linear Progress Indicator
export component M3LinearProgress inherits Rectangle {
    in property <float> progress: 0.0; // 0..1, ignored if indeterminate
    in property <bool> indeterminate: false;
    in property <color> track-color: Theme.m3-surface-container-highest;
    in property <color> indicator-color: Theme.m3-primary;
    in property <length> bar-height: 4px;

    height: root.bar-height;
    min-width: 80px;
    border-radius: root.bar-height / 2;
    background: root.track-color;
    clip: true;

    if !root.indeterminate : Rectangle {
        x: 0; y: 0;
        height: 100%;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: root.bar-height / 2;
        background: root.indicator-color;
    }

    if root.indeterminate : Rectangle {
        y: 0;
        height: 100%;
        width: parent.width * 0.35;
        border-radius: root.bar-height / 2;
        background: root.indicator-color;
        x: (parent.width + self.width) * mod(animation-tick() / 1.2s, 1) - self.width;
    }
}

// Material 3 Circular Progress Indicator (simplified)
export component M3CircularProgress inherits Rectangle {
    in property <float> progress: 0.0; // 0..1
    in property <bool> indeterminate: false;
    in property <length> size: 48px;
    in property <length> stroke: 4px;
    in property <color> track-color: Theme.m3-surface-container-highest;
    in property <color> indicator-color: Theme.m3-primary;

    width: root.size;
    height: root.size;
    background: transparent;

    // track
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.size / 2;
        background: transparent;
        border-width: root.stroke;
        border-color: root.track-color;
    }

    // indicator arc approximation (top segment) - visual reference
    Rectangle {
        width: 100%; height: 100%;
        border-radius: root.size / 2;
        background: transparent;
        border-width: root.stroke;
        border-color: root.indeterminate ? root.indicator-color : root.indicator-color;
        opacity: root.indeterminate ? 1.0 : clamp(root.progress, 0, 1);
    }

    if root.indeterminate : Text {
        text: "◠";
        color: root.indicator-color;
        font-size: root.size * 0.45;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}
