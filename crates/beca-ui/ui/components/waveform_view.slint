import { Theme } from "../theme.slint";
import { OscilloscopeView } from "oscilloscope_view.slint";

export component WaveformView inherits Rectangle {
    in property <string> audio-path-data: "M 0 80 L 508 80";
    in property <length> viewbox-width: 508px;
    in property <length> viewbox-height: 160px;
    in property <length> border-size: 1px;

    height: 160px;
    border-radius: 12px;
    background: @linear-gradient(180deg, Theme.surface 0%, Theme.surface-alt 100%);
    clip: true;

    for i in 4: Rectangle {
        x: 0;
        y: (parent.height / 4) * (i + 1);
        width: 100%;
        height: 1px;
        background: #ffffff0a;
    }
    for i in 7: Rectangle {
        x: (parent.width / 8) * (i + 1);
        y: 0;
        width: 1px;
        height: 100%;
        background: #ffffff08;
    }
    Rectangle {
        width: 100%;
        height: 1px;
        background: #ffffff18;
        y: parent.height / 2;
    }

    OscilloscopeView {
        width: 100%;
        height: 100%;
        audio-path-data: root.audio-path-data;
        viewbox-width: root.viewbox-width;
        viewbox-height: root.viewbox-height;
    }
}
