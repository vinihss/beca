import { Theme } from "theme.slint";

/// Ghost icon button (header/settings actions).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <length> size: 30px;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked;

    width: root.size;
    height: root.size;
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.45;
    background: (touch.has-hover && root.enabled) ? Theme.surface-alt : transparent;

    Text {
        width: 100%;
        height: 100%;
        text: root.icon;
        font-size: 16px;
        color: root.active ? Theme.accent : Theme.text-main;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}
