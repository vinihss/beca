/// Global theme tokens (runtime-settable for beca themes).
export global Theme {
    in-out property <bool> dark-mode: true;
    in-out property <color> background: #1E1E1E;
    in-out property <color> text-main: #FFFFFF;
    in-out property <color> card-bg: #2D2D2D;
    in-out property <color> card-border: #3F3F3F;
    // extended tokens used by app components
    in-out property <brush> surface: #2D2D2D;
    in-out property <brush> surface-alt: #131522;
    in-out property <brush> border: #3F3F3F;
    in-out property <brush> text-strong: #FFFFFF;
    in-out property <brush> accent: #007ACC;
    in-out property <brush> accent-success: #2f6f4f;
    in-out property <brush> accent-danger: #a04040;
    in-out property <brush> recording: #f7768e;
    in-out property <length> radius: 6px;
}
