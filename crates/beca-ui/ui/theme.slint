export global Theme {
    in-out property <bool> dark-mode: true;

    // Legacy/baseline tokens (mapped to M3 purple baseline for compatibility)
    in-out property <color> background: #141218;
    in-out property <color> text-main: #E6E0E9;
    in-out property <color> card-bg: #211F26;
    in-out property <color> card-border: #49454F;

    in-out property <string> icon-font-family: "Material Symbols Outlined";

    in-out property <brush> surface: #211F26;
    in-out property <brush> surface-alt: #2B2930;
    in-out property <brush> border: #49454F;
    in-out property <brush> text-strong: #E6E0E9;
    in-out property <brush> accent: #D0BCFF;
    in-out property <brush> accent-success: #4CAF50;
    in-out property <brush> accent-danger: #F2B8B5;
    in-out property <brush> recording: #F2B8B5;
    in-out property <length> radius: 12px;

    // Material 3 color roles (dark scheme, purple baseline #6750A4)
    in-out property <color> m3-primary: #D0BCFF;
    in-out property <color> m3-on-primary: #381E72;
    in-out property <color> m3-primary-container: #4F378B;
    in-out property <color> m3-on-primary-container: #EADDFF;
    in-out property <color> m3-secondary: #CCC2DC;
    in-out property <color> m3-on-secondary: #332D41;
    in-out property <color> m3-secondary-container: #4A4458;
    in-out property <color> m3-on-secondary-container: #E8DEF8;
    in-out property <color> m3-tertiary: #EFB8C8;
    in-out property <color> m3-on-tertiary: #492532;
    in-out property <color> m3-tertiary-container: #633B48;
    in-out property <color> m3-on-tertiary-container: #FFD8E4;
    in-out property <color> m3-error: #F2B8B5;
    in-out property <color> m3-on-error: #601410;
    in-out property <color> m3-error-container: #8C1D18;
    in-out property <color> m3-on-error-container: #F9DEDC;
    in-out property <color> m3-background: #141218;
    in-out property <color> m3-on-background: #E6E0E9;
    in-out property <color> m3-surface: #141218;
    in-out property <color> m3-on-surface: #E6E0E9;
    in-out property <color> m3-surface-variant: #49454F;
    in-out property <color> m3-on-surface-variant: #CAC4D0;
    in-out property <color> m3-outline: #938F99;
    in-out property <color> m3-outline-variant: #49454F;
    in-out property <color> m3-surface-container-lowest: #0F0D13;
    in-out property <color> m3-surface-container-low: #1D1B20;
    in-out property <color> m3-surface-container: #211F26;
    in-out property <color> m3-surface-container-high: #2B2930;
    in-out property <color> m3-surface-container-highest: #36343B;
    in-out property <color> m3-inverse-surface: #E6E0E9;
    in-out property <color> m3-inverse-on-surface: #322F35;
    in-out property <color> m3-inverse-primary: #6750A4;
    in-out property <color> m3-scrim: #000000;

    // Material 3 shape
    in-out property <length> m3-shape-xs: 4px;
    in-out property <length> m3-shape-sm: 8px;
    in-out property <length> m3-shape-md: 12px;
    in-out property <length> m3-shape-lg: 16px;
    in-out property <length> m3-shape-xl: 28px;
    in-out property <length> m3-shape-full: 9999px;

    // Material 3 state opacities
    in-out property <float> m3-state-hover: 0.08;
    in-out property <float> m3-state-focus: 0.10;
    in-out property <float> m3-state-pressed: 0.10;
    in-out property <float> m3-state-dragged: 0.16;
}
