import { Theme } from "theme.slint";

/// Voice trigger widget for the bar.
export component VoiceWidget inherits Rectangle {
    in property <string> label: "Voice";
    callback clicked;

    min-width: 56px;
    min-height: 24px;
    border-radius: 6px;
    background: touch.has-hover ? Theme.surface-alt : transparent;
    animate background { duration: 120ms; }

    HorizontalLayout {
        alignment: center;
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        Text {
            text: "󰍬";
            color: Theme.accent;
            font-size: 14px;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.text-main;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}