import { DesktopButton, InfoCard, Theme } from "../../ui-lib/ui/library.slint";

export { Theme }

export component WizardWindow inherits Window {
    title: "Setup Wizard";
    width: 600px;
    height: 450px;
    background: Theme.background;

    // Properties managed by Luau
    in property <string> step-title: "Welcome";
    in property <string> step-description: "Initial setup...";
    in property <bool> is-first-step: true;

    // Callbacks to emit to Luau
    callback next-pressed();
    callback back-pressed();

    VerticalLayout {
        padding: 40px;
        spacing: 24px;

        // Header Area
        Text {
            text: "Installation Assistant";
            font-size: 26px;
            font-weight: 800;
            color: Theme.text-main;
        }

        // Main content card fed by dynamic properties
        InfoCard {
            title: root.step-title;
            Text {
                text: root.step-description;
                color: Theme.text-main;
                font-size: 14px;
                wrap: word-wrap;
            }
        }

        // Control Actions Footer Bar
        HorizontalLayout {
            spacing: 16px;
            alignment: end;

            if (!root.is-first-step) : DesktopButton {
                text: "Back";
                height: 38px;
                clicked => { root.back-pressed(); }
            }

            DesktopButton {
                text: "Continue";
                height: 38px;
                clicked => { root.next-pressed(); }
            }
        }
    }
}
