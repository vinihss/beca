import { HorizontalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// Multimedia-style circular/pill icon button.
export component MediaButton inherits Rectangle {
    in property <string> icon;
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <brush> accent: Theme.accent;
    in property <length> size: 48px;
    callback clicked;

    width: root.label == "" ? root.size : 118px;
    height: root.size;
    border-radius: root.height / 2;
    border-width: 1px;
    border-color: #ffffff2e;
    opacity: root.enabled ? 1.0 : 0.4;
    background: !root.enabled ? root.accent
        : touch.pressed ? root.accent.darker(18%)
        : touch.has-hover ? root.accent.brighter(12%)
        : root.accent;
    animate background { duration: 110ms; easing: ease-in-out; }
    animate opacity { duration: 110ms; }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalBox {
        alignment: center;
        spacing: root.label == "" ? 0 : 6px;
        padding-left: root.label == "" ? 0 : 14px;
        padding-right: root.label == "" ? 0 : 14px;
        Text {
            text: root.icon;
            color: Theme.text-strong;
            font-size: root.size * 0.38;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        if root.label != "" : Text {
            text: root.label;
            color: Theme.text-strong;
            font-size: 13px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}
