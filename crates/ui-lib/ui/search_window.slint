import { LineEdit, Button, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";

/// Search/launcher window (module: launcher/apps). Adapted from shell-scripting-starter.
export component SearchWindow inherits Window {
    title: "beca";
    width: 640px;
    height: 460px;
    background: #00000000;

    in-out property <string> placeholder: "Search...";
    in-out property <[string]> results: [];

    callback search_requested(string);
    callback result_selected(string);

    Rectangle {
        background: Theme.card-bg;
        border-radius: 16px;
        border-width: 1px;
        border-color: Theme.card-border;

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            Text {
                text: "Search";
                color: Theme.text-main;
                font-size: 20px;
                font-weight: 700;
            }

            LineEdit {
                placeholder-text: root.placeholder;
                accepted(text) => { root.search_requested(text); }
            }

            Text {
                text: "Press Enter to search. Select a result to launch it.";
                color: Theme.text-main;
                font-size: 12px;
                opacity: 0.7;
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for result in root.results: TouchArea {
                        height: 42px;
                        width: 100%;
                        clicked => { root.result_selected(result); }
                        Rectangle {
                            background: Theme.surface-alt;
                            border-radius: 8px;
                            Text {
                                text: result;
                                color: Theme.text-main;
                                vertical-alignment: center;
                                x: 12px;
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Close";
                    clicked => { root.hide(); }
                }
            }
        }
    }
}
