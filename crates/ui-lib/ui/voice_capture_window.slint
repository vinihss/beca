import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { InfoCard } from "info_card.slint";
import { MediaButton } from "media_button.slint";
import { WaveformView } from "waveform_view.slint";

/// Composed voice-capture window (record/send/cancel with waveform + transcript result).
export component VoiceCaptureWindow inherits Window {
    title: "Voice Capture";
    width: 540px;
    min-height: 300px;
    background: Theme.background;
    default-font-family: "Sans";

    in property <string> audio-path-data: "M 0 80 L 508 80";
    in property <string> status-text: "Gravando...";
    in property <bool> busy: false;
    in property <brush> status-color: Theme.recording;
    in property <bool> show-result: false;
    in property <string> transcript-text: "";
    callback send();
    callback cancel();
    callback copy-text();
    callback close-app();

    VerticalBox {
        padding: 16px;
        spacing: 14px;

        HorizontalBox {
            alignment: center;
            spacing: 8px;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: 5px;
                background: root.status-color;
                opacity: root.busy ? 0.55 : 1.0;
                animate opacity { duration: 120ms; }
            }
            Text {
                text: root.status-text;
                font-size: 16px;
                font-weight: 600;
                color: Theme.text-main;
                vertical-alignment: center;
            }
        }

        if !root.show-result : VerticalBox {
            spacing: 14px;
            WaveformView {
                audio-path-data: root.audio-path-data;
            }

            HorizontalLayout {
                alignment: center;
                spacing: 18px;
                padding-top: 2px;
                MediaButton {
                    icon: "✕";
                    label: "Cancelar";
                    accent: Theme.accent-danger;
                    enabled: !root.busy;
                    clicked => { root.cancel(); }
                }
                MediaButton {
                    icon: root.busy ? "…" : "➤";
                    label: root.busy ? "Enviando" : "Enviar";
                    accent: Theme.accent-success;
                    size: 54px;
                    enabled: !root.busy;
                    clicked => { root.send(); }
                }
            }
        }

        if root.show-result : VerticalBox {
            spacing: 12px;
            InfoCard {
                title: "Transcrição";
                min-height: 140px;
                ScrollView {
                    width: 100%;
                    min-height: 100px;
                    VerticalBox {
                        Text {
                            width: 100%;
                            text: root.transcript-text;
                            color: Theme.text-strong;
                            font-size: 15px;
                            wrap: word-wrap;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: center;
                spacing: 14px;
                padding-top: 2px;
                MediaButton {
                    icon: "⎘";
                    label: "Copiar";
                    accent: Theme.accent;
                    clicked => { root.copy-text(); }
                }
                MediaButton {
                    icon: "✓";
                    label: "Fechar";
                    accent: Theme.accent-success;
                    clicked => { root.close-app(); }
                }
            }
        }
    }
}
