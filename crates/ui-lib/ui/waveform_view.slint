import { Theme } from "theme.slint";

/// Waveform display panel (renders an SVG path provided by backend).
export component WaveformView inherits Rectangle {
    in property <string> audio-path-data: "M 0 80 L 508 80";
    in property <length> viewbox-width: 508px;
    in property <length> viewbox-height: 160px;

    height: 160px;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border;
    background: @linear-gradient(180deg, Theme.surface 0%, Theme.surface-alt 100%);
    clip: true;

    for i in 4: Rectangle {
        x: 0;
        y: (parent.height / 4) * (i + 1);
        width: 100%;
        height: 1px;
        background: #ffffff0a;
    }
    for i in 7: Rectangle {
        x: (parent.width / 8) * (i + 1);
        y: 0;
        width: 1px;
        height: 100%;
        background: #ffffff08;
    }
    Rectangle {
        width: 100%;
        height: 1px;
        background: #ffffff18;
        y: parent.height / 2;
    }

    Path {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        stroke: #7aa2f7;
        stroke-width: 1.8px;
        viewbox-width: root.viewbox-width / 1px;
        viewbox-height: root.viewbox-height / 1px;
        commands: root.audio-path-data;
    }
}
